# Copy to deploy/.env (git-ignored) and fill in. GROCY_URL is set by docker-compose.yml; only needed here
# when running the app or tests outside Docker.
# Grocy API key: Grocy UI -> user menu -> Manage API keys.
GROCY_API_KEY=
ANTHROPIC_API_KEY=
# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). DEMO_KEY works but is heavily rate limited.
FDC_API_KEY=DEMO_KEY
# Optional: Walmart store id, appended to cart links as &storeId=
WALMART_STORE_ID=
# Day the shopping list is built for: 0=Mon ... 6=Sun
SHOPPING_WEEKDAY=6
# Days ahead to flag stock as expiring soon (/api/expiring)
EXPIRY_WARN_DAYS=3
# Home Assistant base URL and a long-lived access token (HA profile -> Security).
HA_URL=
HA_TOKEN=
# Shared secret HA sends as X-House-Secret; setup.sh generates it.
HOOK_SECRET=
# No reminders between these local times
QUIET_HOURS=22:00-07:00
# DATA_DIR defaults to /data (mounted from deploy/data); leave unset in Docker.
# Time zone for the app and Grocy (weekday, shopping window and expiry use the local date). Set your own.
TZ=America/Chicago
